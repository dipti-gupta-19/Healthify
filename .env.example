MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=healthify

# Google AI Studio key — supports both formats:
#   AQ.*  (new auth keys, default in AI Studio)
#   AIza* (legacy standard keys)
GEMINI_API_KEY=

# Optional — Hugging Face image captioning fallback
HUGGINGFACE_API_KEY=
